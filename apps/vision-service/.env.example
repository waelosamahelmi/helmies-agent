# Helmies Studio — Vision Service Environment
NODE_ENV=development
PORT=3007

# Multimodal LLM for vision analysis (OpenAI-compatible)
VISION_MODEL_ENDPOINT="https://api.openai.com/v1"
VISION_MODEL_KEY="${OPENAI_KEY}"
VISION_MODEL_NAME="gpt-4o"

# Alternative: local Florence model
# VISION_BACKEND=florence
# FLORENCE_MODEL_PATH="./models/florence-2"

DATABASE_URL="postgresql://helmies:helmies@localhost:5432/helmies_studio"
