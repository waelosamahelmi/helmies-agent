# Helmies Studio — Platform API Environment
NODE_ENV=development
PORT=3004

# PostgreSQL (shared with landing app)
DATABASE_URL="postgresql://helmies:helmies@localhost:5432/helmies_studio"
DIRECT_URL="postgresql://helmies:helmies@localhost:5432/helmies_studio"

# Redis (for BullMQ queues, caching, rate limiting)
REDIS_URI="redis://localhost:6379"

# NextAuth (shared session validation)
NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="change-me-in-production"

# Stripe
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Provider secret references (actual keys via Docker secrets / env)
WAVESPEED_KEY="${WAVESPEED_KEY}"
ATLAS_KEY="${ATLAS_KEY}"
ALIBABA_KEY="${ALIBABA_KEY}"
OPENROUTER_KEY="${OPENROUTER_KEY}"
KIE_KEY="${KIE_KEY}"

# Object Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH="./uploads"

# Feature flags
FEATURE_WALLET_V2=true
FEATURE_MODEL_GATEWAY_V2=true
FEATURE_PRICING_PREFLIGHT=true
FEATURE_AGENT_CREATIVE_TOOLS=true
FEATURE_DIRECTOR=true
FEATURE_ADMIN_V2=true
